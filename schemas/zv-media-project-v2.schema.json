{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZV Media Evidence Project V2",
  "type": "object",
  "properties": {
    "outlet_slots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "items"],
      "properties": {
        "version": {"const": 1},
        "items": {
          "type": "array", "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["slot_id", "kind", "ordinal", "binding_id"],
            "properties": {
              "slot_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,96}$"},
              "kind": {"type": "string", "enum": ["picture", "video", "audio"]},
              "ordinal": {"type": "integer", "minimum": 1, "maximum": 1000000},
              "binding_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,96}$"}
            }
          }
        }
      }
    },
    "schema_version": {
      "const": 2
    },
    "project_clock": {
      "type": "object",
      "properties": {
        "fps": {
          "type": "number",
          "minimum": 1,
          "maximum": 240
        }
      },
      "required": [
        "fps"
      ],
      "additionalProperties": false
    },
    "output_canvas": {
      "type": "object",
      "description": "Optional consumer canvas supplied to the media desk. Video outlets inherit it unless their legacy per-outlet size inputs are explicitly connected.",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 32,
          "maximum": 16384,
          "multipleOf": 32
        },
        "height": {
          "type": "integer",
          "minimum": 32,
          "maximum": 16384,
          "multipleOf": 32
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "kind": {
            "enum": [
              "picture",
              "video",
              "audio"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "source_handle": {
            "type": "string",
            "pattern": "^originals/[a-f0-9]{32}\\.(png|jpg|jpeg|webp|bmp|mp4|mov|mkv|webm|avi|wav|mp3|m4a|flac|ogg)$"
          },
          "capture": {
            "type": "object",
            "description": "Server-registry provenance for an independent native video-frame picture; canonical facts replace client claims.",
            "properties": {
              "method": {"type": "string", "const": "video_frame"},
              "source_handle": {"type": "string", "pattern": "^originals/[a-f0-9]{32}\\.(mp4|mov|mkv|webm|avi)$"},
              "source_seconds": {"type": "number", "minimum": 0, "maximum": 3600},
              "frame_seconds": {"type": "number", "minimum": 0, "maximum": 3600},
              "playhead_seconds": {"type": "number", "minimum": 0, "maximum": 43200}
            },
            "required": ["method", "source_handle", "source_seconds", "frame_seconds", "playhead_seconds"],
            "additionalProperties": false
          },
          "probe": {
            "type": "object",
            "properties": {
              "size_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 536870912
              },
              "duration_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 3600
              },
              "width": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 16384
              },
              "height": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 16384
              },
              "fps": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000
              },
              "frame_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 3600000
              },
              "frame_count_exact": {
                "type": "boolean"
              },
              "vfr": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "has_audio": {
                "type": "boolean"
              },
              "sample_rate": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 768000
              },
              "channels": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 64
              },
              "codec": {
                "type": "string"
              }
            },
            "required": [
              "size_bytes",
              "duration_seconds",
              "width",
              "height",
              "fps",
              "frame_count",
              "frame_count_exact",
              "vfr",
              "has_audio",
              "sample_rate",
              "channels",
              "codec"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "asset_id",
          "kind",
          "name",
          "source_handle",
          "probe"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "picture_track": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "asset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 512
          }
        },
        "required": [
          "item_id",
          "asset_id",
          "order"
        ],
        "additionalProperties": false
      },
      "maxItems": 512
    },
    "video_track": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clip_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "asset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "timeline_in_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 43200
          },
          "source_in_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 43200
          },
          "source_out_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 43200
          },
          "source_audio_enabled": {
            "type": "boolean"
          },
          "audio_link_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "timeline_out_seconds": {
            "type": "number",
            "minimum": -43200,
            "maximum": 86400
          },
          "duration_seconds": {
            "type": "number",
            "minimum": -43200,
            "maximum": 43200
          },
          "source_in_frame": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source_out_frame": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source_frame_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "project_frame_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "frame_estimated": {
            "type": "boolean"
          }
        },
        "required": [
          "clip_id",
          "asset_id",
          "timeline_in_seconds",
          "source_in_seconds",
          "source_out_seconds",
          "source_audio_enabled",
          "audio_link_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 512
    },
    "audio_track": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clip_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "asset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "timeline_in_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 43200
          },
          "source_in_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 43200
          },
          "source_out_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 43200
          },
          "origin": {
            "enum": [
              "standalone",
              "video_source"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "linked_video_clip_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_video_clip_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "timeline_out_seconds": {
            "type": "number",
            "minimum": -43200,
            "maximum": 86400
          },
          "duration_seconds": {
            "type": "number",
            "minimum": -43200,
            "maximum": 43200
          },
          "source_in_frame": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source_out_frame": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source_frame_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "project_frame_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "frame_estimated": {
            "type": "boolean"
          }
        },
        "required": [
          "clip_id",
          "asset_id",
          "timeline_in_seconds",
          "source_in_seconds",
          "source_out_seconds",
          "origin",
          "enabled",
          "linked_video_clip_id",
          "source_video_clip_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 512
    },
    "processing_window": {
      "type": "object",
      "properties": {
        "start_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 43200
        },
        "end_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 43200
        },
        "fps": {
          "type": "number",
          "minimum": 1,
          "maximum": 240
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end_frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "frame_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "start_seconds",
        "end_seconds",
        "fps"
      ],
      "additionalProperties": false
    },
    "label_map": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "track": {
            "enum": [
              "picture",
              "video",
              "audio"
            ]
          },
          "item_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "asset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "label": {
            "type": "string"
          },
          "ordinal": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "track",
          "item_id",
          "asset_id",
          "label",
          "ordinal"
        ],
        "additionalProperties": false
      },
      "maxItems": 1536
    },
    "validation": {
      "type": "object",
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "code",
              "message"
            ],
            "additionalProperties": false
          },
          "maxItems": 8192
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "code",
              "message"
            ],
            "additionalProperties": false
          },
          "maxItems": 4096
        }
      },
      "required": [
        "errors",
        "warnings"
      ],
      "additionalProperties": false
    },
    "processing_preset": {
      "type": "object",
      "properties": {
        "preset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "preset_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "description": {
              "type": "string",
              "maxLength": 1000
            },
            "strategy": {
              "type": "string",
              "enum": [
                "single_window",
                "auto_segment"
              ]
            },
            "rules": {
              "type": "object",
              "properties": {
                "target_fps": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 240
                },
                "min_frames": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 10368000
                },
                "max_frames": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 10368000
                },
                "max_seconds": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 1e-09,
                  "maximum": 43200
                },
                "align_to_grid": {
                  "type": "boolean"
                },
                "segment_min_seconds": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 1e-09,
                  "maximum": 43200
                },
                "segment_max_seconds": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 1e-09,
                  "maximum": 43200
                },
                "overlap_frames": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10368000,
                  "description": "请求重叠帧数；实际采用值由 overlap_alignment 派生，不能把请求值直接作为分段重叠。"
                },
                "overlap_alignment": {
                  "type": "string",
                  "enum": [
                    "exact",
                    "h3_guide"
                  ],
                  "description": "重叠对齐策略：exact 原样采用请求帧数（普通自动分段默认）；h3_guide 向下对齐为 1 或 5+17k 帧，仅用于显式选择的 H3 Guide 规则。"
                }
              },
              "required": [
                "target_fps",
                "min_frames",
                "max_frames",
                "max_seconds",
                "align_to_grid",
                "segment_min_seconds",
                "segment_max_seconds",
                "overlap_frames",
                "overlap_alignment"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "overlap_alignment": {
                        "const": "h3_guide"
                      }
                    },
                    "required": [
                      "overlap_alignment"
                    ]
                  },
                  "then": {
                    "properties": {
                      "overlap_frames": {
                        "minimum": 1
                      }
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "name",
            "description",
            "strategy",
            "rules"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "preset_id",
        "preset_version",
        "snapshot"
      ],
      "additionalProperties": false
    },
    "preset_compatibility": {
      "type": "object",
      "properties": {
        "compatible": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "code",
              "message"
            ],
            "additionalProperties": false
          },
          "maxItems": 4096
        },
        "target_fps": {
          "type": "number",
          "minimum": 1e-09,
          "maximum": 240
        },
        "frame_count": {
          "type": "integer",
          "minimum": 0
        },
        "effective_min_frames": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "effective_max_frames": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "effective_max_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "segment_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "rules_only": {
          "type": "boolean"
        },
        "requested_overlap_frames": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "自动分段的请求重叠帧数；非分段策略为 null。"
        },
        "effective_overlap_frames": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "按快照中的重叠对齐策略得到的实际重叠帧数，用于覆盖校验和段数计算；非分段策略为 null。"
        },
        "segment_stride_frames": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "有效单段最多帧数减实际重叠帧数，供预计段数计算；非分段策略或无法形成有效步长时为 null。"
        }
      },
      "required": [
        "compatible",
        "issues",
        "target_fps",
        "frame_count",
        "effective_min_frames",
        "effective_max_frames",
        "effective_max_seconds",
        "segment_count",
        "rules_only",
        "requested_overlap_frames",
        "effective_overlap_frames",
        "segment_stride_frames"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "project_clock",
    "assets",
    "picture_track",
    "video_track",
    "audio_track",
    "processing_window",
    "processing_preset"
  ],
  "additionalProperties": false
}

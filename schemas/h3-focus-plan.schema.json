{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zf-promptdirector:h3-focus-plan-v1",
  "title": "H3 Focus Interview Plan v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "h3-focus-plan-v1"
    },
    "profile": {
      "enum": [
        "local_t8",
        "cloud_strict"
      ]
    },
    "profile_limits": {
      "type": "object",
      "properties": {
        "video_total_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audio_total_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "mode": {
      "enum": [
        "auto",
        "T2VA",
        "I2VA",
        "FL2VA",
        "L2VA",
        "Ref2VA"
      ]
    },
    "mode_override": {
      "enum": [
        null,
        "T2VA",
        "I2VA",
        "FL2VA",
        "L2VA",
        "Ref2VA"
      ]
    },
    "effective_mode": {
      "enum": [
        "T2VA",
        "I2VA",
        "FL2VA",
        "L2VA",
        "Ref2VA"
      ]
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "label_counters": {
      "type": "object",
      "properties": {
        "Picture": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "Video": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "Audio": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "Subject": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "Picture",
        "Video",
        "Audio",
        "Subject"
      ],
      "additionalProperties": false
    },
    "media_assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/media_asset"
      },
      "minItems": 0
    },
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subject"
      },
      "minItems": 0
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shot"
      },
      "minItems": 1
    },
    "style": {
      "type": [
        "string",
        "null"
      ]
    },
    "ref2va": {
      "type": "object",
      "properties": {
        "task_types": {
          "type": "array",
          "items": {
            "enum": [
              "keyframe completion",
              "reference generation",
              "video editing",
              "video continuation",
              "audio reuse",
              "audio reference"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "task_types",
        "summary"
      ],
      "additionalProperties": false
    },
    "overall_soundscape": {
      "type": [
        "string",
        "null"
      ]
    },
    "non_diegetic_music": {
      "type": [
        "string",
        "null"
      ]
    },
    "locks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lock"
      },
      "minItems": 0
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      },
      "minItems": 0
    },
    "segmentation": {
      "$ref": "#/$defs/segmentation"
    },
    "ready": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "profile",
    "mode",
    "duration_seconds",
    "media_assets",
    "subjects",
    "shots",
    "style",
    "ref2va",
    "overall_soundscape",
    "non_diegetic_music",
    "locks",
    "gaps",
    "segmentation"
  ],
  "additionalProperties": false,
  "$defs": {
    "window": {
      "type": "object",
      "properties": {
        "in_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "out_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "in_frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "out_frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "in_sample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "out_sample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "in_seconds",
        "out_seconds"
      ],
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "relationship": {
          "enum": [
            "fully_preserved",
            "partially_preserved",
            "attribute_transfer",
            "weak_reference",
            "fully_copy",
            "partially_copy",
            "reference"
          ]
        },
        "placement": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "relationship",
        "placement",
        "details"
      ],
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "properties": {
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fps": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "frame_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sample_rate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sample_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "has_audio": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "model_input": {
      "type": "object",
      "properties": {
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "fps",
        "frame_count"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "string",
          "minLength": 1
        },
        "clock_id": {
          "type": "string",
          "minLength": 1
        },
        "clock_offset_seconds": {
          "type": "number",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991
        }
      },
      "required": [
        "handle"
      ],
      "additionalProperties": false
    },
    "media_asset": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "picture",
            "video",
            "audio"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "probe": {
          "$ref": "#/$defs/probe"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "official_label": {
          "type": "string"
        },
        "role": {
          "enum": [
            "subject_source",
            "first_frame",
            "last_frame",
            "keyframe",
            "storyboard",
            "video_edit",
            "video_continue",
            "structure_reference",
            "audio_reuse",
            "audio_reference"
          ]
        },
        "selected": {
          "type": "boolean"
        },
        "selected_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/window"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_input": {
          "anyOf": [
            {
              "$ref": "#/$defs/model_input"
            },
            {
              "type": "null"
            }
          ]
        },
        "audio_enabled": {
          "type": "boolean"
        },
        "paired_audio_asset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_video_asset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "definition": {
          "type": [
            "string",
            "null"
          ]
        },
        "retention": {
          "anyOf": [
            {
              "$ref": "#/$defs/retention"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "asset_id",
        "kind",
        "source",
        "probe",
        "role",
        "selected",
        "selected_window"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "official_label": {
          "type": "string"
        },
        "source_asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "definition": {
          "type": [
            "string",
            "null"
          ]
        },
        "retention": {
          "anyOf": [
            {
              "$ref": "#/$defs/retention"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "subject_id",
        "source_asset_ids",
        "definition",
        "retention"
      ],
      "additionalProperties": false
    },
    "dialogue": {
      "type": "object",
      "properties": {
        "speaker_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^S[1-9][0-9]*$"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "delivery": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": "string",
          "pattern": "^[^\\[\\]<>\\r\\n]+$"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "after": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "speaker_id",
        "source",
        "delivery",
        "language",
        "text",
        "after"
      ],
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "cut_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "composition": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "subject_description": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "camera": {
          "type": [
            "string",
            "null"
          ]
        },
        "sound": {
          "type": [
            "string",
            "null"
          ]
        },
        "dialogue": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dialogue"
          },
          "minItems": 0
        },
        "visible_text": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "description",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "reference_placements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "target_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "label",
              "text",
              "target_seconds"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "order",
        "cut_seconds",
        "composition",
        "subject_ids",
        "subject_description",
        "environment",
        "action",
        "camera",
        "sound",
        "dialogue",
        "visible_text",
        "reference_placements"
      ],
      "additionalProperties": false
    },
    "gap": {
      "type": "object",
      "properties": {
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "value_type": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean"
          ]
        },
        "context": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "resolved",
            "skipped"
          ]
        }
      },
      "required": [
        "id",
        "path",
        "required",
        "value_type",
        "context",
        "status"
      ],
      "additionalProperties": false
    },
    "lock": {
      "type": "object",
      "properties": {
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "null",
            "object",
            "array"
          ],
          "maximum": 9007199254740991,
          "minimum": -9007199254740991
        }
      },
      "required": [
        "path",
        "value"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "enum": [
            "synchronized",
            "reference"
          ]
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/window"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_input": {
          "anyOf": [
            {
              "$ref": "#/$defs/model_input"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "asset_id",
        "timing",
        "window",
        "model_input"
      ],
      "additionalProperties": false
    },
    "segmentation": {
      "type": "object",
      "properties": {
        "strategy": {
          "enum": [
            "none",
            "uniform_edit",
            "narrative"
          ]
        },
        "clock": {
          "enum": [
            "source_seconds"
          ]
        },
        "clock_id": {
          "type": "string",
          "minLength": 1
        },
        "global_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "shared_lock_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "order": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "source_window": {
                "$ref": "#/$defs/window"
              },
              "local_prompt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "selections": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/selection"
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "order",
              "source_window",
              "local_prompt",
              "selections"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "strategy",
        "clock",
        "clock_id",
        "global_prompt",
        "shared_lock_paths",
        "segments"
      ],
      "additionalProperties": false
    }
  }
}
